# Copie para .env.local (que é ignorado pelo git) ou use `vercel env pull .env.local`.

# Postgres do Neon — vem pronto da integração Vercel Marketplace
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Assina os tokens de corrida entregues ao cliente. 32+ bytes aleatórios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Assina o cookie de sessão do painel de moderação. Outro valor, não repita o de cima.
SESSION_SECRET=

# scrypt da senha do painel: npm run admin:hash -- "sua senha"
ADMIN_PASSWORD_HASH=

# Código do cofre da tela de manutenção (3 dígitos). Opcional: sem a variável
# vale o padrão '199'. Fica comentado de propósito — definir vazio
# (MANUTENCAO_CODIGO=) DESLIGA o cofre e passa a exigir a senha, então copiar
# este arquivo não pode deixar a linha vazia por acidente.
# É uma tranca social, não segurança: quem segura a força bruta é o rate limit
# da rota, já que 3 dígitos são só 1000 combinações.
#MANUTENCAO_CODIGO=199

# scrypt de uma senha só para a manutenção, para não reusar a do painel.
# Opcional: sem ela vale ADMIN_PASSWORD_HASH.
#MANUTENCAO_HASH=
