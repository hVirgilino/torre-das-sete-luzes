# Copie para .env.local (que é ignorado pelo git) ou use `vercel env pull .env.local`.

# Postgres do Neon — vem pronto da integração Vercel Marketplace
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Assina os tokens de corrida entregues ao cliente. 32+ bytes aleatórios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Assina o cookie de sessão do painel de moderação. Outro valor, não repita o de cima.
SESSION_SECRET=

# scrypt da senha do painel: npm run admin:hash -- "sua senha"
ADMIN_PASSWORD_HASH=
